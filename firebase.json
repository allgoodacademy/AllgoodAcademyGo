{
  "hosting": {
    "public": "public",
    "redirects": [
      { "source": "/educational-games/jolenes-lemonade-challenge/**", "destination": "/", "type": 301 },
      { "source": "/jsh/rage-revenue/**", "destination": "/", "type": 301 },
      { "source": "/jsh/finding-yourself/**", "destination": "/", "type": 301 },
      { "source": "/goodblocks/aico-pilot/**", "destination": "/", "type": 301 },
      { "source": "/goodblocks/airport-navigator/**", "destination": "/", "type": 301 },
      { "source": "/goodblocks/cogat-logic-lab/**", "destination": "/", "type": 301 },
      { "source": "/goodblocks/cogat-verbal-practice/**", "destination": "/", "type": 301 },
      { "source": "/goodblocks/digital-asset-defense/**", "destination": "/", "type": 301 },
      { "source": "/goodblocks/your-digital-identity/**", "destination": "/", "type": 301 },
      { "source": "/educational-games/conflict-resolution-challenge/**", "destination": "/", "type": 301 },
      { "source": "/educational-games/master-your-story-challenge/**", "destination": "/", "type": 301 },
      { "source": "/educational-games/purposeful-communicator-challenge/**", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/**/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/assets/js/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/assets/css/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}