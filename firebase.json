{
  "hosting": {
    "public": "public",
    "redirects": [
      {
        "source": "/privacy",
        "destination": "/privacy.html",
        "type": 301
      },
      {
        "source": "/privacy/",
        "destination": "/privacy.html",
        "type": 301
      },
      {
        "source": "/privacy/**",
        "destination": "/privacy.html",
        "type": 301
      },
      {
        "source": "/educational-games/jolenes-lemonade-challenge/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/jsh/rage-revenue/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/jsh/finding-yourself/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/goodblocks/aico-pilot/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/goodblocks/airport-navigator/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/goodblocks/cogat-logic-lab/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/goodblocks/cogat-verbal-practice/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/goodblocks/digital-asset-defense/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/goodblocks/your-digital-identity/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/educational-games/conflict-resolution-challenge/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/educational-games/master-your-story-challenge/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/educational-games/purposeful-communicator-challenge/**",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/**/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/css/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/mission-control/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/dashboard/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/mission-control/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com https://www.gstatic.com https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://allgood-academy.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
