rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin access is locked to these two accounts by their verified sign-in email —
    // not a document field, since any signed-in user could otherwise write that field
    // on their own profile and grant themselves access.
    // Sentinel for "no classroom code on this document". See classroomOwnedBy().
    function NONE() { return '__none__'; }

    function isAllowlistedAdmin() {
      // email_verified is required in addition to the email match: with "one account per
      // email address" off in Firebase Auth settings, an unverified account could
      // otherwise claim one of these two addresses via email/password sign-up (no proof
      // of ownership) and pass this check on email alone. Verified-status still needs
      // confirming against live Firebase Auth console settings (see Ticket 5 in the PR
      // description) — this change is correct hardening regardless of that setting.
      return request.auth != null &&
        request.auth.token.email in ['balgood93@gmail.com', 'learning@allgoodacademy.com'] &&
        request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Ownership of a classroom is proven by the CLASSROOM document, never by a field on
    // the requester's own profile. This is the pivot the roster rules below turn on: a
    // classroom doc can only be created naming yourself teacher, and only its own teacher
    // can update or delete it (rule #5), so teacherUid is not self-assertable the way
    // users/{uid}.role is.
    // NONE is a sentinel that is a VALID path segment but can never be a real classroom
    // code (codes are A-Z0-9, generated by generateClassroomCode()). Using it as the
    // default keeps every exists()/get() below operating on a well-formed path: rules do
    // not reliably short-circuit, so interpolating an empty or malformed string here would
    // raise an evaluation error rather than evaluate to false. Both deny, but an erroring
    // rule is a rule nobody can reason about.
    function classroomOwnedBy(appId, code, uid) {
      return code is string
        && code != NONE()
        && code.matches('^[A-Za-z0-9_-]{1,64}$')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(code))
        && get(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(code)).data.teacherUid == uid;
    }

    // A teacher's ACTIVE classroom code — read off their own profile, the field the
    // become-a-teacher flow writes and Mission Control's class switcher rewrites. Since
    // 2026-11-25 a teacher may own more than one class; this is the one they are looking at,
    // and teacherCodeOk() below guarantees it can only ever name a class they own. Joining
    // someone ELSE's class as a member never touches this field (see classroom_members).
    function myClassroomCode(appId, uid) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid))
        ? get(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)).data.get('classroomCode', NONE())
        : NONE();
    }

    // The class this uid TEACHES right now: their active code, but only when the CLASSROOM
    // document says they are its teacher; NONE otherwise.
    //
    // Fixed 2026-11-25. The grants below used myClassroomCode() directly, and a student's
    // profile carries a classroomCode too (the join-by-code mirror). So for a student the
    // "teacher's class" resolved to their OWN class, and isMemberOfClassroom() then let them
    // read every classmate's profile (#4), subcollections (#6) and sessions (#10b) — the
    // events grant added for Mission Control's drill-down would have inherited it. Pinning
    // the code to classroomOwnedBy() closes that for all four. Teachers are unaffected: their
    // active code always names a class they own (teacherCodeOk() guarantees it).
    function myTaughtClassroomCode(appId, uid) {
      return classroomOwnedBy(appId, myClassroomCode(appId, uid), uid) ? myClassroomCode(appId, uid) : NONE();
    }

    // Is `memberUid` a member of the classroom `code`? Membership is its own join-table
    // document (classroom_members/{code}_{uid}) rather than a field on the student's
    // profile, specifically so a student (or a teacher acting as one) can belong to more
    // than one classroom at once — a single classroomCode field can't represent that, and
    // a rule that tried to check "any of N codes on this profile" would need an unbounded
    // loop rules_version 2 cannot express. The deterministic doc ID means this is one
    // exists() call regardless of how many classrooms the member is actually in.
    function isMemberOfClassroom(appId, memberUid, code) {
      return code is string
        && code != NONE()
        && code.matches('^[A-Za-z0-9_-]{1,64}$')
        && memberUid is string
        && memberUid != NONE()
        && memberUid.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/classroom_members/$(code + '_' + memberUid));
    }

    // The ORIGINAL single-classroomCode-field check, kept verbatim as a fallback: everyone
    // who joined before classroom_members existed has a classroomCode on their profile and
    // no membership doc, and deploying the rule below without this would silently drop every
    // one of them from their teacher's roster the moment it went live — not a hypothetical,
    // an already-live classroom would break on deploy. New joins get a classroom_members doc
    // (see #6b) AND still mirror this field for non-teachers (see joinClassroom in
    // dashboard/index.html), so this path keeps working for both old and new members; only
    // multi-classroom membership requires the join table.
    function isLegacySingleClassroomStudent(appId, uid, teacherUid) {
      return uid is string
        && uid != NONE()
        && uid.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid))
        && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)).data.get('role', NONE()) == 'student'
        && classroomOwnedBy(appId,
             get(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)).data.get('classroomCode', NONE()),
             teacherUid);
    }

    // Is the owner of this telemetry session a member of a classroom this uid teaches?
    // Authorization comes from the CLASSROOM document (via myClassroomCode + the
    // classroom_members join table, OR the legacy single-field fallback above), never from a
    // role field alone. No role check on the join-table path — a Task Force Leader who has
    // also joined another teacher's classroom as a member is exactly as visible there as any
    // other member, same as everywhere else this pivot is used (rules #4/#6).
    function sessionOwnerIsMyStudent(appId, uid, teacherUid) {
      return isMemberOfClassroom(appId, uid, myTaughtClassroomCode(appId, teacherUid))
        || isLegacySingleClassroomStudent(appId, uid, teacherUid);
    }

    // A classroom code the client may legitimately move to: unchanged, cleared, or one
    // that actually exists (join-by-code — knowing the code is the trust model, as in #5).
    function classroomCodeOk(appId, priorCode) {
      return request.resource.data.get('classroomCode', NONE()) == priorCode
        || request.resource.data.get('classroomCode', NONE()) == NONE()
        || (request.resource.data.get('classroomCode', NONE()).matches('^[A-Za-z0-9_-]{1,64}$')
            && exists(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(request.resource.data.get('classroomCode', NONE()))));
    }

    // What a client is allowed to do to the two privileged fields on its OWN profile.
    // Everything else on the profile stays freely writable by its owner.
    //   role         : may be left alone, set to 'student', or set to 'teacher' ONLY by a
    //                  signed-in (Google or email) account for a classroom this uid owns
    //                  (Mission Control's setup creates the classroom first, then flips
    //                  the role). An existing teacher's role is "left alone", so teachers
    //                  from before the teacher-sign-in rule keep working unchanged.
    //   classroomCode: may be left alone, cleared, or set to a classroom that exists
    //                  (the join-by-code flow — knowing the code is the trust model, as
    //                  for rule #5; joining someone else's classroom grants no read access).
    // displayName is otherwise unbounded free text a student can put in front of their
    // teacher in Mission Control (public/mission-control/index.html — rendered via esc(),
    // so this is a length/abuse guard, not an XSS control). No character restriction:
    // only a sane length cap. 60 gives generous headroom over the longest real value —
    // the widest recruit-code-derived name (longest descriptor + animal + flavor words,
    // plus the " ####" suffix from Ticket 1) tops out well under 30 characters — while
    // still comfortably fitting any real teacher/account name a person would type.
    function displayNameOk() {
      return !('displayName' in request.resource.data)
        || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60);
    }

    // Only teachers sign in (identity reset, 2026-11-23), with Google or with an email and
    // password. True when either is one of this account's linked providers — whether the
    // session signed in with it or linked it onto an earlier anonymous session — and false
    // for a purely anonymous session (a student). Read with get() defaults so a token
    // without the claim is a plain false, never an error.
    //
    //    A STUDENT SAVE CODE is not a teacher sign-in. Since 2026-11-24 a student may save
    //    their progress (public/js/student-save.js) by linking an email/password credential
    //    whose address is at save.allgoodacademy.com — a synthetic address derived from
    //    their save code, never a real mailbox. That puts 'email' among the token's
    //    identities, so those addresses are excluded here: a save code can never create a
    //    classroom or become a teacher. (A 13+ student who saves with Google has the same
    //    standing as anyone else with a Google account, exactly as before.)
    function hasTeacherSignIn() {
      return request.auth.token.get('firebase', {}).get('identities', {}).keys().hasAny(['google.com', 'email'])
        && !(request.auth.token.get('email', '') is string
             && request.auth.token.get('email', '').matches('.*@save[.]allgoodacademy[.]com$'));
    }

    // A TEACHER'S ACTIVE CLASS (Mission Control, more than one class, 2026-11-25).
    // users/{uid}.classroomCode on a teacher's profile means "the class I am looking at right
    // now", and every teacher grant below (#4, #6, #10b, #11b) keys off it through
    // myClassroomCode(). Switching classes in Mission Control's header writes the new code
    // here, so every grant follows whichever class is active without a single rule learning
    // about more than one class.
    //
    // That only holds if a teacher can point the field at THEIR OWN classes and nobody
    // else's. classroomCodeOk() alone allows any class that exists (the student join-by-code
    // model), which for a teacher would mean: set it to another teacher's code and read that
    // class's roster. So for anyone who is or is becoming a teacher, the new code must be
    // unchanged, cleared, or a class whose teacherUid is this uid.
    function teacherCodeOk(appId, priorRole, priorCode) {
      return !(priorRole == 'teacher' || request.resource.data.get('role', NONE()) == 'teacher')
        || request.resource.data.get('classroomCode', NONE()) == priorCode
        || request.resource.data.get('classroomCode', NONE()) == NONE()
        || classroomOwnedBy(appId, request.resource.data.get('classroomCode', NONE()), request.auth.uid);
    }

    function profileFieldsOk(appId, priorRole, priorCode) {
      return (request.resource.data.get('role', NONE()) == priorRole
              || request.resource.data.get('role', NONE()) == 'student'
              || (request.resource.data.get('role', NONE()) == 'teacher'
                  && hasTeacherSignIn()
                  && classroomOwnedBy(appId, request.resource.data.get('classroomCode', NONE()), request.auth.uid)))
        && classroomCodeOk(appId, priorCode)
        && teacherCodeOk(appId, priorRole, priorCode)
        && displayNameOk();
    }

    // THE PRO PLAN (2026-11-25). A teacher's plan lives in teacher_plans/{uid}, a document
    // only the admin allowlist can write (rule #13) — set from Insider today, by the payment
    // system later. Never a field on the teacher's own profile: that document is
    // self-writable, so a plan there would be a plan anyone could grant themselves.
    // Pro means plan == 'pro' AND proUntil is still in the future; an expired plan is simply
    // free again, with nothing deleted.
    function planPath(appId, uid) {
      return /databases/$(database)/documents/artifacts/$(appId)/teacher_plans/$(uid);
    }
    function isProTeacher(appId, uid) {
      return exists(planPath(appId, uid))
        && get(planPath(appId, uid)).data.get('plan', 'free') == 'pro'
        && get(planPath(appId, uid)).data.get('proUntil', null) is timestamp
        && get(planPath(appId, uid)).data.proUntil > request.time;
    }

    // THE FREE CLASS MARKER (rule #14). Created alongside a teacher's first class and never
    // deletable by the teacher. A free teacher may create a classroom only while no marker
    // exists; the create must bring the marker into existence in the same batch (getAfter),
    // naming the class being created. So the second create on the free plan is denied however
    // the teacher edits their own profile — the profile is not consulted at all.
    function freeMarkerPath(appId, uid) {
      return /databases/$(database)/documents/artifacts/$(appId)/teacher_free_class/$(uid);
    }

    // May this teacher still CHANGE this class (assignments, extras)? Always while Pro. On
    // the free plan, only the class the marker names: when Pro lapses, extra classes stay
    // readable — nothing is deleted — but become read-only. A teacher with no marker at all
    // (one whose class predates the plan) keeps full write access; Mission Control writes
    // their marker the first time they load it.
    function classWritable(appId, code, uid) {
      return isProTeacher(appId, uid)
        || !exists(freeMarkerPath(appId, uid))
        || get(freeMarkerPath(appId, uid)).data.get('firstClassCode', NONE()) == code;
    }

    // 2. The user's own PROFILE document. Split out from its subcollections (2b) because
    //    this is the one document whose contents decide authorization elsewhere, so its
    //    writes are field-constrained rather than wide open.
    //
    //    Previously this was a single `{document=**}` rule granting unrestricted write.
    //    Under rules_version 2 a recursive wildcard matches zero or more segments, so that
    //    rule covered the profile doc itself — which meant any signed-in user, including an
    //    anonymous guest, could merge {role:'teacher', classroomCode:'<someone-elses>'} onto
    //    their own profile in one write. Rules #4/#6 then read role and classroomCode back
    //    off that same self-written document to decide who was a teacher, so a single write
    //    bought a full classroom roster: names, emails and progress.
    match /artifacts/{appId}/users/{userId} {
      allow get: if isOwner(userId) || isAllowlistedAdmin();

      // 1. Insider's user directory enumerates the whole collection. A LIST grant has to
      //    sit on the DOCUMENT match like this one: a `match /artifacts/{appId}/users`
      //    statement addresses the collection itself, which no request path ever matches,
      //    so the grant that used to live there was dead code. It went unnoticed because
      //    2b was once a single `{document=**}` rule whose zero-segment match covered this
      //    profile document, and `read` there implied `list`. Splitting the rules for the
      //    privilege fix took the admin's list grant with it and Insider's `users` source
      //    started coming back permission-denied. Admin-only: rule #4 is what lets a
      //    teacher list their own roster, and nobody else may enumerate learners.
      allow list: if isAllowlistedAdmin();

      allow create: if isOwner(userId) && profileFieldsOk(appId, NONE(), NONE());
      allow update: if isOwner(userId)
        && profileFieldsOk(appId, resource.data.get('role', NONE()), resource.data.get('classroomCode', NONE()));

      // Deletion-request fulfilment (Insider's "delete this user's data" tool).
      allow delete: if isAllowlistedAdmin();
    }

    // 2b. Everything UNDER the profile — module_progress, game_scores, launches,
    //     continuity_bank, scenario_attempts. No field constraints: nothing in here is
    //     consulted to decide authorization.
    match /artifacts/{appId}/users/{userId}/{subcollection}/{document=**} {
      allow read, write: if isOwner(userId);
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 4. NEW — Teachers can list + read (not write) the top-level profiles of members who
    //    joined THEIR classroom. Members outside a teacher's own classroom stay fully private.
    //    This does NOT expose a member's subcollections (launches/scores) — only the fields
    //    on their main user doc (name, email, classroomCode, role) that the roster view needs.
    //
    //    No role check on the GET path: membership is proven by the classroom_members join
    //    table, so a Task Force Leader who has also joined another teacher's classroom is
    //    visible in that roster the same as anyone else — being a teacher of your own
    //    classroom elsewhere doesn't exempt you from being a member here.
    //
    //    GET and LIST are two separate grants below, and that split is forced by Firestore,
    //    not a preference. `list` and `get` were originally one grant sharing one condition;
    //    that condition takes `userId`, and on a LIST the rule is matched against the
    //    COLLECTION path, so the trailing `{userId}` wildcard is unbound — null. Every
    //    branch then raised a null-value error before any of them could return a verdict
    //    (`userId is string` errors on null too, so guarding it doesn't help), so the whole
    //    grant errored, `list` was denied for everyone, and Mission Control — which loads by
    //    listing the roster — failed with a full-page permission error for every teacher,
    //    including one with an empty brand-new classroom. Per-document `get` was unaffected,
    //    which is why the original test suite passed: it only ever tested `get`.
    match /artifacts/{appId}/users/{userId} {
      //    Authorization comes from the CLASSROOM document (via myClassroomCode + the
      //    classroom_members join table, OR the legacy single-field fallback), not from
      //    role/classroomCode asserted some other way on the requester's own profile — those
      //    are self-written and were trivially forgeable (see rule #2).
      allow get: if request.auth != null
        && (isMemberOfClassroom(appId, userId, myTaughtClassroomCode(appId, request.auth.uid))
            || isLegacySingleClassroomStudent(appId, userId, request.auth.uid));

      //    The LIST grant is written against `resource`, never `userId`. `resource.data` IS
      //    populated on a list (it is evaluated per document the query returns — that is the
      //    whole reason "rules are not filters": the query fails unless EVERY returned
      //    document passes), so the target profile's own role and classroomCode are readable
      //    here, and reading them needs no document access call at all.
      //
      //    The security pivot is unchanged: `classroomOwnedBy` proves, from the CLASSROOM
      //    document, that the requester is that classroom's teacher. The role/classroomCode
      //    read here are on the TARGET student's profile, which is exactly what the legacy
      //    fallback already did via get() on the get path — not on the requester's own
      //    profile, which is the self-assertable document the #2 hardening was about. A
      //    student writing someone else's classroomCode onto their own profile only puts
      //    THEMSELVES on that roster (which is what joining by code does anyway, see
      //    classroomCodeOk) and buys them no read access to anyone.
      //
      //    Consequences worth knowing before editing this:
      //      - A query must filter on BOTH role == 'student' AND the classroom code, or it
      //        returns a document this rule denies and the whole query fails. Mission
      //        Control's roster query does exactly that.
      //      - Document access stays O(1), not O(students): every document the query returns
      //        resolves classroomOwnedBy against the SAME classroom path, and rules cache
      //        document lookups per path within a request. A rule that did a get() per
      //        returned document instead would blow Firestore's access budget as soon as a
      //        classroom grew past a handful of students — the hazard rule #10b documents.
      //      - This path reaches legacy members only (a mirrored classroomCode on the
      //        profile). A join-table-only member, and anyone whose own classroomCode points
      //        at a DIFFERENT classroom they also joined, is discovered from
      //        classroom_members (#6b) and read with a per-document get above — the wildcard
      //        is bound there, so the join-table branch still authorizes them.
      allow list: if request.auth != null
        && resource.data.get('role', NONE()) == 'student'
        && classroomOwnedBy(appId, resource.data.get('classroomCode', NONE()), request.auth.uid);
    }

    // 5. NEW — Classrooms: holds each teacher's join code.
    //    - Anyone signed in can GET a specific code (needed so a student can validate a code exists)
    //    - Only a teacher can CREATE a classroom, and only naming themselves as its teacher
    //    - Only that classroom's teacher can update/delete it later
    //    - LIST is denied to everyone except the admin allowlist (Insider's classrooms overview) —
    //      codes are otherwise shared out-of-band, no student/teacher should browse all classrooms
    match /artifacts/{appId}/classrooms/{code} {
      allow get: if request.auth != null;
      // Creating a class is the teacher step, so it needs a teacher sign-in (Google or email),
      // never an anonymous student session. Updating your own class (assignments) does not:
      // existing teachers keep working as they are.
      //
      // THE CLASS LIMIT (Pro plan, 2026-11-25): a Pro teacher may create any number; a free
      // teacher may create one, and that create must write their free-class marker (#14) in
      // the same batch, naming this code. See freeMarkerPath() above.
      allow create: if request.auth != null && hasTeacherSignIn()
        && request.resource.data.teacherUid == request.auth.uid
        && (isProTeacher(appId, request.auth.uid)
            || (!exists(freeMarkerPath(appId, request.auth.uid))
                && existsAfter(freeMarkerPath(appId, request.auth.uid))
                && getAfter(freeMarkerPath(appId, request.auth.uid)).data.get('firstClassCode', NONE()) == code));
      // Updating is the class's own teacher, and only while the class is writable on their
      // plan: an extra class becomes read-only when Pro lapses (classWritable).
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid
        && classWritable(appId, code, request.auth.uid);
      // LIST: the admin allowlist (Insider), or a teacher listing THEIR OWN classes for the
      // class switcher — query classrooms where teacherUid == uid. Written against
      // resource.data (populated per returned document on a list), never the {code}
      // wildcard, which is null on a list (see #4). A query that is not filtered to the
      // requester's own uid returns a document this denies, so the whole query fails.
      allow list: if isAllowlistedAdmin()
        || (request.auth != null && resource.data.teacherUid == request.auth.uid);
    }

    // 6. NEW — Teachers can READ (not write) a classroom member's subcollections too
    //    (game_scores, launches) — needed so the roster can show real completion/scores,
    //    not just names. Still fully scoped to the teacher's own classroom, still read-only.
    // SAVE CODES ARE NEVER STORED UNDER users/{uid}. This rule and the teacher get on the
    // profile above are why: a student's save code (public/js/student-save.js) works like a
    // password, and everything under users/{uid} is readable by that student's teacher. The
    // code lives only in Firebase Auth (as a credential) and in the student's own browser
    // storage. scripts/check-invariants.js ("save-code") keeps it out of Firestore.
    match /artifacts/{appId}/users/{userId}/{subcollection}/{document=**} {
      //    Same pivot as #4: the teacher is identified by the classroom document (via
      //    myClassroomCode + classroom_members, OR the legacy fallback), never by fields the
      //    requester wrote onto their own profile.
      allow read: if request.auth != null
        && (isMemberOfClassroom(appId, userId, myTaughtClassroomCode(appId, request.auth.uid))
            || isLegacySingleClassroomStudent(appId, userId, request.auth.uid));
    }

    // 6b. NEW — Classroom membership (many-to-many: a student, or a Task Force Leader
    //     acting as one, may belong to more than one classroom; a classroom has many
    //     members). Deterministic doc ID `{classroomCode}_{uid}` so create/delete never
    //     need a query and a second join to the same classroom is a no-op, not a duplicate.
    //     - READ: the member themselves, or that classroom's teacher (roster access)
    //     - CREATE: only naming yourself, only for a classroom that exists, only at the ID
    //       the classroomCode+uid pair requires — knowing the code is the trust model, same
    //       as classrooms (#5) and Recruit Codes
    //     - DELETE: only the member themselves (leaving) — a teacher cannot remove a member
    //     - UPDATE: never; leave and rejoin instead of editing a membership in place
    //     - LIST: evaluated per returned document exactly like GET, so a member listing
    //       their own memberships (uid == me) or a teacher listing their roster
    //       (classroomCode == my classroom) both work without a separate admin grant
    match /artifacts/{appId}/classroom_members/{membershipId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || classroomOwnedBy(appId, resource.data.get('classroomCode', NONE()), request.auth.uid));
      // create AND update share one condition — joining a classroom you're already in is a
      // harmless idempotent setDoc({merge:true}), which Firestore evaluates as an update once
      // the doc exists, not a second create. Nothing about a membership doc is ever supposed
      // to change after the fact (that is what "leave and rejoin" is for), so both operations
      // are held to exactly the same shape rather than letting update be a separate, looser door.
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['classroomCode', 'uid', 'joinedAt'])
        && request.resource.data.classroomCode is string
        && request.resource.data.classroomCode.matches('^[A-Za-z0-9_-]{1,64}$')
        && membershipId == (request.resource.data.classroomCode + '_' + request.auth.uid)
        && exists(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(request.resource.data.classroomCode));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 6c. NEW — PER-STUDENT EXTRA ASSIGNMENTS. What one named student was given ON TOP OF
    //     the Task Force's class-wide set (classrooms/{code}.assignedModules / .assignedGames).
    //     Same deterministic-ID join-table shape as #6b: `{classroomCode}_{uid}`, so a
    //     teacher writes or clears one student's extras without a query, and a student reads
    //     their own with a single get.
    //
    //     WHY THIS IS NOT A FIELD ON THE CLASSROOM DOCUMENT. The obvious design is
    //     classrooms/{code}.assignedByStudent = { uid: [...] }, and it is a privacy bug: rule
    //     #5 grants `get` on a classroom document to ANY signed-in user, deliberately, so a
    //     student can validate a code before joining. The code itself is shared out loud in
    //     class. Per-student assignments on that document would therefore be readable by
    //     every classmate — and by anyone who has ever heard the code — which is a
    //     behavioural record about a named minor. It lives in its own collection precisely so
    //     the read grant can be narrow.
    //
    //     WRITE IS THE MIRROR IMAGE OF #6b. A membership is created by the STUDENT (joining
    //     is their act, and knowing the code is the trust model). An assignment is created by
    //     the TEACHER and by nobody else — a student must not be able to hand themselves, or
    //     a classmate, extra work. So the write condition pivots on classroomOwnedBy, the
    //     same classroom-document proof rules #4/#5/#6 use, never on a self-written field.
    match /artifacts/{appId}/classroom_assignments/{assignmentId} {
      //    READ: the student it is about, or that classroom's teacher. Written against
      //    `resource.data` and never against the {assignmentId} wildcard — the wildcard is
      //    null during a LIST, which is exactly the null-value evaluation error that took
      //    rule #4 (and with it the whole of Mission Control) down. A teacher lists their
      //    classroom's assignments with where('classroomCode','==',code), and because every
      //    returned document resolves classroomOwnedBy against the SAME classroom path,
      //    document access stays O(1) rather than O(students).
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || classroomOwnedBy(appId, resource.data.get('classroomCode', NONE()), request.auth.uid));

      //    CREATE and UPDATE share one condition, as in #6b: re-saving a student's extras is
      //    an ordinary idempotent setDoc({merge:true}), which Firestore evaluates as an
      //    update once the document exists, and there is no reason for the second door to be
      //    looser than the first. The doc ID is pinned to the code+uid pair so a teacher
      //    cannot file one student's extras under another student's ID, and the field list is
      //    closed so this document can never grow a field that something else authorizes on.
      //
      //  `sims` (2026-11-25) holds assigned simulations, for the same reasons the classroom
      //  keeps them in assignedSims beside assignedGames. Optional, so every extras document
      //  written before it existed still validates on its next save.
      allow create, update: if request.auth != null
        && classroomOwnedBy(appId, request.resource.data.get('classroomCode', NONE()), request.auth.uid)
        && classWritable(appId, request.resource.data.get('classroomCode', NONE()), request.auth.uid)
        && request.resource.data.keys().hasOnly(['classroomCode', 'uid', 'modules', 'games', 'sims', 'updatedAt'])
        && (!('sims' in request.resource.data)
            || (request.resource.data.sims is list && request.resource.data.sims.size() <= 100))
        && request.resource.data.classroomCode is string
        && request.resource.data.classroomCode.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.uid is string
        && request.resource.data.uid.matches('^[A-Za-z0-9_-]{1,128}$')
        && assignmentId == (request.resource.data.classroomCode + '_' + request.resource.data.uid)
        //  Both lists are required and bounded. The cap is not a security boundary — the only
        //  writer is already the classroom's own teacher — it is a guard against a client bug
        //  writing an unbounded array into a document every roster read then pays for.
        && request.resource.data.modules is list
        && request.resource.data.modules.size() <= 100
        && request.resource.data.games is list
        && request.resource.data.games.size() <= 100;

      //    DELETE: the teacher, so "clear this student's extras" is a real delete rather than
      //    an empty document left behind. The student cannot delete their own — unassigning
      //    yourself is not a thing.
      allow delete: if request.auth != null
        && classroomOwnedBy(appId, resource.data.get('classroomCode', NONE()), request.auth.uid);
    }

    // 7. NEW — Message HQ. Flat top-level collection (not nested per-user) so any portal —
    //    dashboard, DDC, or any future module — writes here directly and Insider reads it
    //    with a plain query, no collectionGroup gymnastics or per-module rule changes needed.
    match /artifacts/{appId}/messages/{msgId} {
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 8. NEW — Course feedback (end-of-module rating + comment), also flat and top-level,
    //    kept separate from game_scores so that collection stays focused on progress/completion.
    match /artifacts/{appId}/course_feedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 8b. NEW — Topic selections: what a student answered to "what do you want to get
    //     better at?" in Comms (/js/message-hq.js). Deliberately the SAME shape as
    //     course_feedback directly above, and for the same reasons: flat, top-level,
    //     create-for-yourself, admin-read.
    //
    //     NOT student-readable, and that is the point rather than an oversight. A list of
    //     what a child has repeatedly said they are bad at is a behavioural record about a
    //     minor; nothing in the product reads it back to them, so nothing should be able
    //     to. `create` is pinned to the requester's own uid so one student cannot file a
    //     selection under another's name, exactly as the feedback rule does.
    //
    //     Rows written before the 2026-11 identity reset carry ageTier; newer rows do not,
    //     because every student is now treated as a child and a deletion request is answered
    //     by uid. It is listed in scripts/prune-telemetry.js.
    match /artifacts/{appId}/topic_selections/{selectionId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 9. Recruit Codes — READ-ONLY, legacy (identity reset, 2026-11-23). The pre-2026-11
    //    model gave each under-13 Learner Recruit a passphrase (e.g. "arctic-fox-trot-4821")
    //    whose document held a portable copy of their progress. Nothing creates or updates
    //    one any more. The dashboard's "Have an old code?" restore, the only reader, was
    //    removed on 2026-11-25, so the GET below is now unused and can be dropped (kept for
    //    now so this change stays a no-op for the rules tests). Knowing the code was the
    //    trust model.
    //    - GET: any signed-in session, one document by its exact id
    //    - LIST (any query or enumeration): admin allowlist only — codes are never browsable
    //    - CREATE / UPDATE: nobody (falls to the catch-all deny)
    //    - DELETE: admin only (Insider's deletion-request tool)
    //    The data itself is kept; deleting it is a separate, later decision.
    match /artifacts/{appId}/recruit_codes/{code} {
      allow get: if request.auth != null;
      allow list: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 10. NEW — Telemetry sessions (see /js/telemetry.js). One doc per module visit:
    //     uid, module, startedAt/lastSeenAt, activeMs, maxStep/stepsTotal, completed,
    //     device, entry. Flat and top-level for the same reason as messages: Insider
    //     reads the whole thing with one plain query.
    //     - CREATE: only naming yourself as the session's uid
    //     - UPDATE: only your own session, and the uid on it can never be reassigned
    //     - READ/LIST/DELETE: admin allowlist only
    match /artifacts/{appId}/sessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow read, delete: if isAllowlistedAdmin();
    }

    // 10b. NEW — Mission Control (public/mission-control/) is a teacher's own view of their
    //      own Task Force, and time-on-task is the one figure it cannot source anywhere else:
    //      activeMs exists only on a session document. game_scores and module_progress cover
    //      completion and position, but neither records how long anyone actually spent.
    //      Read-only, and scoped to students in a classroom this uid demonstrably teaches —
    //      the same boundary rule #6 already draws around those students' subcollections, so
    //      this exposes no learner a teacher could not already see.
    //
    //      Mission Control queries this ONE UID AT A TIME (where('uid','==',studentUid)), and
    //      that is load-bearing rather than a style choice. Rules allow at most 10 document
    //      access calls per query and the lookups below are cached per distinct path within a
    //      request, so a query pinned to a single uid resolves the same two paths for every
    //      document it returns and costs 2. A classroom-wide query would need a fresh user
    //      lookup per document and would start failing once a classroom passed a handful of
    //      students — quietly, and only in the classrooms big enough to hit it.
    match /artifacts/{appId}/sessions/{sessionId} {
      allow read: if request.auth != null
        && sessionOwnerIsMyStudent(appId, resource.data.get('uid', NONE()), request.auth.uid);
    }

    // 11. NEW — Telemetry events (append-only stream: module_open, step, choice,
    //     module_complete, ...). Nobody but the admin allowlist can read them back,
    //     and nothing can edit one after the fact.
    //
    //     `stream` is the reporting population the visit belongs to ('core' for the site's
    //     own funnel, 'pattern-lab' for the free CogAT-style practice diagnostic) — see the
    //     STREAMS note in /js/telemetry.js. It is a top-level field, not a `meta` key, so
    //     an excluded stream can be filtered without unpacking every event's meta map, and
    //     so this allowlist is the one place that records which streams exist.
    match /artifacts/{appId}/events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'role', 'ageTier', 'isGuest', 'module', 'gameName', 'stream',
             'sessionId', 'event', 'step', 'meta', 'device', 'entry', 'ts', 'clientTs'
           ]);
      allow read, delete: if isAllowlistedAdmin();
    }

    // 11b. NEW (2026-11-25) — Mission Control's drill-down: a teacher reads the events of
    //      students in their OWN class (each step, each choice, each prediction), so they can
    //      see where the class got stuck and which answer each student picked. Exactly the
    //      boundary rule 10b draws around sessions: the event's uid must be a member of the
    //      class this teacher demonstrably owns (classroom document, via myClassroomCode +
    //      classroom_members, or the legacy single-field fallback). Read-only. Students see
    //      nothing new, and no name is ever written into an event.
    //
    //      Queried ONE UID AT A TIME (where('uid','==',studentUid)), for the reason 10b gives:
    //      a query pinned to one uid resolves the same few paths for every document it
    //      returns, so it stays inside Firestore's ten-document-access budget however many
    //      events the student has. A class-wide query would not.
    match /artifacts/{appId}/events/{eventId} {
      allow read: if request.auth != null
        && sessionOwnerIsMyStudent(appId, resource.data.get('uid', NONE()), request.auth.uid);
    }

    // 13. NEW (2026-11-25) — TEACHER PLANS. teacher_plans/{uid}: { plan: 'free' | 'pro',
    //     proUntil: timestamp, grantedBy, note, updatedAt }. ONLY the admin allowlist writes it
    //     (Insider's Plan control today; the payment system later, which will write with the
    //     Admin SDK and bypass rules altogether). A teacher may read their own — that is how
    //     Mission Control knows which plan to show — and nobody else's.
    match /artifacts/{appId}/teacher_plans/{uid} {
      allow get: if isOwner(uid) || isAllowlistedAdmin();
      allow list: if isAllowlistedAdmin();
      allow create, update: if isAllowlistedAdmin()
        && request.resource.data.keys().hasOnly(['plan', 'proUntil', 'grantedBy', 'note', 'updatedAt'])
        && request.resource.data.plan in ['free', 'pro']
        && (request.resource.data.get('proUntil', null) == null || request.resource.data.proUntil is timestamp)
        && (request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500);
      allow delete: if isAllowlistedAdmin();
    }

    // 14. NEW (2026-11-25) — THE FREE CLASS MARKER. teacher_free_class/{uid}: { firstClassCode,
    //     createdAt }. Create-only, by the teacher it is about, and only naming a class they
    //     own once the write lands (getAfter, so it works both in the same batch as the
    //     class's create and on its own, when Mission Control backfills one for a teacher
    //     whose class predates the plan). Never updated; deleted only by the admin. See the
    //     class create rule in #5 for how it enforces the free plan's one class.
    match /artifacts/{appId}/teacher_free_class/{uid} {
      allow get: if isOwner(uid) || isAllowlistedAdmin();
      allow list: if isAllowlistedAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['firstClassCode', 'createdAt'])
        && request.resource.data.firstClassCode is string
        && request.resource.data.firstClassCode.matches('^[A-Za-z0-9_-]{1,64}$')
        && existsAfter(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(request.resource.data.firstClassCode))
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(request.resource.data.firstClassCode)).data.teacherUid == uid;
      allow delete: if isAllowlistedAdmin();
    }

    // The root-level `game_sessions` collection is GONE (2026-09-13). All four standalone
    // games — Read the Signal, Before You Send, The Rumor Mill, Money Moves — now write
    // through the shared telemetry pipe (/js/telemetry.js) to artifacts/{appId}/sessions
    // and artifacts/{appId}/events, exactly like every GoodBlock and Challenge. That
    // retires two things at once: a collection sitting outside the app's own namespace,
    // and four hand-maintained per-game hasOnly() field allowlists that had to be edited
    // every time a game learned to record one more number.
    //
    // Rules 10 / 10b / 11 above already cover the games completely and no new rule was
    // needed: a game's per-category roll-up rides on the session document's `summary`
    // map (teacher-readable via 10b), and its per-scenario skill tag rides in the `meta`
    // of an ordinary `choice` event (11). Nothing was migrated because nothing was there:
    // zero real game sessions existed when this cut over. Any write to the old path now
    // falls through to the catch-all deny at the bottom of this file.

    // 12. NEW — Collection-group reads for Insider. Rule #2 already lets the admin
    //     allowlist read any one user's subcollections, but a collectionGroup() query
    //     (every user's launches / game_scores / ... in ONE read, instead of one round
    //     trip per user) is only permitted by a rule written against the collection
    //     id with a {path=**} prefix. Admin-only, read-only — no new write paths.
    match /{path=**}/launches/{docId} {
      allow read: if isAllowlistedAdmin();
    }
    match /{path=**}/game_scores/{docId} {
      allow read: if isAllowlistedAdmin();
    }
    match /{path=**}/scenario_attempts/{docId} {
      allow read: if isAllowlistedAdmin();
    }
    match /{path=**}/module_progress/{docId} {
      allow read: if isAllowlistedAdmin();
    }

    // 3. Safety Catch: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
