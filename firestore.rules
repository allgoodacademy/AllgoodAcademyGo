rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin access is locked to these two accounts by their verified sign-in email —
    // not a document field, since any signed-in user could otherwise write that field
    // on their own profile and grant themselves access.
    // Sentinel for "no classroom code on this document". See classroomOwnedBy().
    function NONE() { return '__none__'; }

    function isAllowlistedAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['balgood93@gmail.com', 'learning@allgoodacademy.com'];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Ownership of a classroom is proven by the CLASSROOM document, never by a field on
    // the requester's own profile. This is the pivot the roster rules below turn on: a
    // classroom doc can only be created naming yourself teacher, and only its own teacher
    // can update or delete it (rule #5), so teacherUid is not self-assertable the way
    // users/{uid}.role is.
    // NONE is a sentinel that is a VALID path segment but can never be a real classroom
    // code (codes are A-Z0-9, generated by generateClassroomCode()). Using it as the
    // default keeps every exists()/get() below operating on a well-formed path: rules do
    // not reliably short-circuit, so interpolating an empty or malformed string here would
    // raise an evaluation error rather than evaluate to false. Both deny, but an erroring
    // rule is a rule nobody can reason about.
    function classroomOwnedBy(appId, code, uid) {
      return code is string
        && code != NONE()
        && code.matches('^[A-Za-z0-9_-]{1,64}$')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(code))
        && get(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(code)).data.teacherUid == uid;
    }

    // A teacher's OWN classroom code — read off their own profile, exactly the same field
    // the become-a-teacher flow writes there. Unlike a student, a teacher still only ever
    // teaches ONE classroom (creating a second would need a second flow that doesn't exist),
    // so this is safe to treat as a single value even after multi-membership below: joining
    // someone ELSE's Task Force as a member never touches this field (see classroom_members).
    function myClassroomCode(appId, uid) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid))
        ? get(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)).data.get('classroomCode', NONE())
        : NONE();
    }

    // Is `memberUid` a member of the classroom `code`? Membership is its own join-table
    // document (classroom_members/{code}_{uid}) rather than a field on the student's
    // profile, specifically so a student (or a teacher acting as one) can belong to more
    // than one classroom at once — a single classroomCode field can't represent that, and
    // a rule that tried to check "any of N codes on this profile" would need an unbounded
    // loop rules_version 2 cannot express. The deterministic doc ID means this is one
    // exists() call regardless of how many classrooms the member is actually in.
    function isMemberOfClassroom(appId, memberUid, code) {
      return code is string
        && code != NONE()
        && code.matches('^[A-Za-z0-9_-]{1,64}$')
        && memberUid is string
        && memberUid != NONE()
        && memberUid.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/classroom_members/$(code + '_' + memberUid));
    }

    // The ORIGINAL single-classroomCode-field check, kept verbatim as a fallback: everyone
    // who joined before classroom_members existed has a classroomCode on their profile and
    // no membership doc, and deploying the rule below without this would silently drop every
    // one of them from their teacher's roster the moment it went live — not a hypothetical,
    // an already-live classroom would break on deploy. New joins get a classroom_members doc
    // (see #6b) AND still mirror this field for non-teachers (see joinClassroom in
    // dashboard/index.html), so this path keeps working for both old and new members; only
    // multi-classroom membership requires the join table.
    function isLegacySingleClassroomStudent(appId, uid, teacherUid) {
      return uid is string
        && uid != NONE()
        && uid.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid))
        && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)).data.get('role', NONE()) == 'student'
        && classroomOwnedBy(appId,
             get(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)).data.get('classroomCode', NONE()),
             teacherUid);
    }

    // Is the owner of this telemetry session a member of a classroom this uid teaches?
    // Authorization comes from the CLASSROOM document (via myClassroomCode + the
    // classroom_members join table, OR the legacy single-field fallback above), never from a
    // role field alone. No role check on the join-table path — a Task Force Leader who has
    // also joined another teacher's classroom as a member is exactly as visible there as any
    // other member, same as everywhere else this pivot is used (rules #4/#6).
    function sessionOwnerIsMyStudent(appId, uid, teacherUid) {
      return isMemberOfClassroom(appId, uid, myClassroomCode(appId, teacherUid))
        || isLegacySingleClassroomStudent(appId, uid, teacherUid);
    }

    // A classroom code the client may legitimately move to: unchanged, cleared, or one
    // that actually exists (join-by-code — knowing the code is the trust model, as in #5).
    function classroomCodeOk(appId, priorCode) {
      return request.resource.data.get('classroomCode', NONE()) == priorCode
        || request.resource.data.get('classroomCode', NONE()) == NONE()
        || (request.resource.data.get('classroomCode', NONE()).matches('^[A-Za-z0-9_-]{1,64}$')
            && exists(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(request.resource.data.get('classroomCode', NONE()))));
    }

    // What a client is allowed to do to the two privileged fields on its OWN profile.
    // Everything else on the profile stays freely writable by its owner.
    //   role         : may be left alone, set to 'student', or set to 'teacher' ONLY for a
    //                  classroom this uid demonstrably owns (the become-a-teacher flow
    //                  creates the classroom first, then flips the role).
    //   classroomCode: may be left alone, cleared, or set to a classroom that exists
    //                  (the join-by-code flow — knowing the code is the trust model, as
    //                  for rule #5; joining someone else's classroom grants no read access).
    function profileFieldsOk(appId, priorRole, priorCode) {
      return (request.resource.data.get('role', NONE()) == priorRole
              || request.resource.data.get('role', NONE()) == 'student'
              || (request.resource.data.get('role', NONE()) == 'teacher'
                  && classroomOwnedBy(appId, request.resource.data.get('classroomCode', NONE()), request.auth.uid)))
        && classroomCodeOk(appId, priorCode);
    }

    // 2. The user's own PROFILE document. Split out from its subcollections (2b) because
    //    this is the one document whose contents decide authorization elsewhere, so its
    //    writes are field-constrained rather than wide open.
    //
    //    Previously this was a single `{document=**}` rule granting unrestricted write.
    //    Under rules_version 2 a recursive wildcard matches zero or more segments, so that
    //    rule covered the profile doc itself — which meant any signed-in user, including an
    //    anonymous guest, could merge {role:'teacher', classroomCode:'<someone-elses>'} onto
    //    their own profile in one write. Rules #4/#6 then read role and classroomCode back
    //    off that same self-written document to decide who was a teacher, so a single write
    //    bought a full classroom roster: names, emails, ageTier, recruit codes and progress.
    match /artifacts/{appId}/users/{userId} {
      allow get: if isOwner(userId) || isAllowlistedAdmin();

      // 1. Insider's user directory enumerates the whole collection. A LIST grant has to
      //    sit on the DOCUMENT match like this one: a `match /artifacts/{appId}/users`
      //    statement addresses the collection itself, which no request path ever matches,
      //    so the grant that used to live there was dead code. It went unnoticed because
      //    2b was once a single `{document=**}` rule whose zero-segment match covered this
      //    profile document, and `read` there implied `list`. Splitting the rules for the
      //    privilege fix took the admin's list grant with it and Insider's `users` source
      //    started coming back permission-denied. Admin-only: rule #4 is what lets a
      //    teacher list their own roster, and nobody else may enumerate learners.
      allow list: if isAllowlistedAdmin();

      allow create: if isOwner(userId) && profileFieldsOk(appId, NONE(), NONE());
      allow update: if isOwner(userId)
        && profileFieldsOk(appId, resource.data.get('role', NONE()), resource.data.get('classroomCode', NONE()));

      // Deletion-request fulfilment (Insider's "delete this user's data" tool).
      allow delete: if isAllowlistedAdmin();
    }

    // 2b. Everything UNDER the profile — module_progress, game_scores, launches,
    //     continuity_bank, scenario_attempts. No field constraints: nothing in here is
    //     consulted to decide authorization.
    match /artifacts/{appId}/users/{userId}/{subcollection}/{document=**} {
      allow read, write: if isOwner(userId);
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 4. NEW — Teachers can list + read (not write) the top-level profiles of members who
    //    joined THEIR classroom. Members outside a teacher's own classroom stay fully private.
    //    This does NOT expose a member's subcollections (launches/scores) — only the fields
    //    on their main user doc (name, email, classroomCode, role) that the roster view needs.
    //
    //    No role check: membership is proven by the classroom_members join table, so a Task
    //    Force Leader who has also joined another teacher's classroom is visible in that
    //    roster the same as anyone else — being a teacher of your own classroom elsewhere
    //    doesn't exempt you from being a member here.
    match /artifacts/{appId}/users/{userId} {
      //    Authorization comes from the CLASSROOM document (via myClassroomCode + the
      //    classroom_members join table, OR the legacy single-field fallback), not from
      //    role/classroomCode asserted some other way on the requester's own profile — those
      //    are self-written and were trivially forgeable (see rule #2).
      allow list, get: if request.auth != null
        && (isMemberOfClassroom(appId, userId, myClassroomCode(appId, request.auth.uid))
            || isLegacySingleClassroomStudent(appId, userId, request.auth.uid));
    }

    // 5. NEW — Classrooms: holds each teacher's join code.
    //    - Anyone signed in can GET a specific code (needed so a student can validate a code exists)
    //    - Only a teacher can CREATE a classroom, and only naming themselves as its teacher
    //    - Only that classroom's teacher can update/delete it later
    //    - LIST is denied to everyone except the admin allowlist (Insider's classrooms overview) —
    //      codes are otherwise shared out-of-band, no student/teacher should browse all classrooms
    match /artifacts/{appId}/classrooms/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow list: if isAllowlistedAdmin();
    }

    // 6. NEW — Teachers can READ (not write) a classroom member's subcollections too
    //    (game_scores, launches) — needed so the roster can show real completion/scores,
    //    not just names. Still fully scoped to the teacher's own classroom, still read-only.
    match /artifacts/{appId}/users/{userId}/{subcollection}/{document=**} {
      //    Same pivot as #4: the teacher is identified by the classroom document (via
      //    myClassroomCode + classroom_members, OR the legacy fallback), never by fields the
      //    requester wrote onto their own profile.
      allow read: if request.auth != null
        && (isMemberOfClassroom(appId, userId, myClassroomCode(appId, request.auth.uid))
            || isLegacySingleClassroomStudent(appId, userId, request.auth.uid));
    }

    // 6b. NEW — Classroom membership (many-to-many: a student, or a Task Force Leader
    //     acting as one, may belong to more than one classroom; a classroom has many
    //     members). Deterministic doc ID `{classroomCode}_{uid}` so create/delete never
    //     need a query and a second join to the same classroom is a no-op, not a duplicate.
    //     - READ: the member themselves, or that classroom's teacher (roster access)
    //     - CREATE: only naming yourself, only for a classroom that exists, only at the ID
    //       the classroomCode+uid pair requires — knowing the code is the trust model, same
    //       as classrooms (#5) and Recruit Codes
    //     - DELETE: only the member themselves (leaving) — a teacher cannot remove a member
    //     - UPDATE: never; leave and rejoin instead of editing a membership in place
    //     - LIST: evaluated per returned document exactly like GET, so a member listing
    //       their own memberships (uid == me) or a teacher listing their roster
    //       (classroomCode == my classroom) both work without a separate admin grant
    match /artifacts/{appId}/classroom_members/{membershipId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || classroomOwnedBy(appId, resource.data.get('classroomCode', NONE()), request.auth.uid));
      // create AND update share one condition — joining a classroom you're already in is a
      // harmless idempotent setDoc({merge:true}), which Firestore evaluates as an update once
      // the doc exists, not a second create. Nothing about a membership doc is ever supposed
      // to change after the fact (that is what "leave and rejoin" is for), so both operations
      // are held to exactly the same shape rather than letting update be a separate, looser door.
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['classroomCode', 'uid', 'joinedAt'])
        && request.resource.data.classroomCode is string
        && request.resource.data.classroomCode.matches('^[A-Za-z0-9_-]{1,64}$')
        && membershipId == (request.resource.data.classroomCode + '_' + request.auth.uid)
        && exists(/databases/$(database)/documents/artifacts/$(appId)/classrooms/$(request.resource.data.classroomCode));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 7. NEW — Message HQ. Flat top-level collection (not nested per-user) so any portal —
    //    dashboard, DDC, or any future module — writes here directly and Insider reads it
    //    with a plain query, no collectionGroup gymnastics or per-module rule changes needed.
    match /artifacts/{appId}/messages/{msgId} {
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 8. NEW — Course feedback (end-of-module rating + comment), also flat and top-level,
    //    kept separate from game_scores so that collection stays focused on progress/completion.
    match /artifacts/{appId}/course_feedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 8b. NEW — Topic selections: what a student answered to "what do you want to get
    //     better at?" in Comms (/js/message-hq.js). Deliberately the SAME shape as
    //     course_feedback directly above, and for the same reasons: flat, top-level,
    //     create-for-yourself, admin-read.
    //
    //     NOT student-readable, and that is the point rather than an oversight. A list of
    //     what a child has repeatedly said they are bad at is a behavioural record about a
    //     minor; nothing in the product reads it back to them, so nothing should be able
    //     to. `create` is pinned to the requester's own uid so one student cannot file a
    //     selection under another's name, exactly as the feedback rule does.
    //
    //     Every document carries ageTier (stamped in auth-core.js recordTopicSelection),
    //     so an under-13 row can be found for a parental deletion request without joining
    //     back to the user document — the same property that made course_feedback
    //     answerable. It is listed in scripts/prune-telemetry.js for the same reason.
    match /artifacts/{appId}/topic_selections/{selectionId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAllowlistedAdmin();
      allow delete: if isAllowlistedAdmin();
    }

    // 9. NEW — Recruit Codes: a Learner Recruit's memorable passphrase (e.g.
    //    "arctic-fox-trot"), doubling as the portable copy of their identity + progress
    //    used to reclaim their account on a different device (Firebase's anonymous auth
    //    has no built-in way to resume a specific old anonymous session from a code alone).
    //    Deliberately the SAME trust model as a classroom code above: knowing the exact
    //    passphrase is treated as sufficient proof of ownership, not a cryptographic
    //    secret — that's why `update` is open to any signed-in user rather than gated to
    //    the current uid on the doc, unlike classroom's update rule. Redeeming a code on a
    //    new device is *itself* a legitimate ownership change (the new device's uid isn't
    //    the one already on the document), so an owner-gated update would block the exact
    //    thing this collection exists to do.
    //    - GET: anyone signed in can look up a code (needed to validate uniqueness when
    //      generating a new one, and to redeem an existing one)
    //    - CREATE: only naming yourself as the code's initial owner
    //    - UPDATE: open to any signed-in user — covers both redemption (uid pointer moves
    //      to the new device) and ongoing progress mirroring from whichever uid is active
    //    - LIST: admin allowlist only, same as classrooms — codes aren't meant to be browsed
    match /artifacts/{appId}/recruit_codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow list: if isAllowlistedAdmin();
      // Deletion-request fulfilment: Insider removes the code doc along with the rest
      // of a Learner Recruit's data, otherwise their mirrored progress would linger.
      allow delete: if isAllowlistedAdmin();
    }

    // 10. NEW — Telemetry sessions (see /js/telemetry.js). One doc per module visit:
    //     uid, module, startedAt/lastSeenAt, activeMs, maxStep/stepsTotal, completed,
    //     device, entry. Flat and top-level for the same reason as messages: Insider
    //     reads the whole thing with one plain query.
    //     - CREATE: only naming yourself as the session's uid
    //     - UPDATE: only your own session, and the uid on it can never be reassigned
    //     - READ/LIST/DELETE: admin allowlist only
    match /artifacts/{appId}/sessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow read, delete: if isAllowlistedAdmin();
    }

    // 10b. NEW — Mission Control (public/mission-control/) is a teacher's own view of their
    //      own Task Force, and time-on-task is the one figure it cannot source anywhere else:
    //      activeMs exists only on a session document. game_scores and module_progress cover
    //      completion and position, but neither records how long anyone actually spent.
    //      Read-only, and scoped to students in a classroom this uid demonstrably teaches —
    //      the same boundary rule #6 already draws around those students' subcollections, so
    //      this exposes no learner a teacher could not already see.
    //
    //      Mission Control queries this ONE UID AT A TIME (where('uid','==',studentUid)), and
    //      that is load-bearing rather than a style choice. Rules allow at most 10 document
    //      access calls per query and the lookups below are cached per distinct path within a
    //      request, so a query pinned to a single uid resolves the same two paths for every
    //      document it returns and costs 2. A classroom-wide query would need a fresh user
    //      lookup per document and would start failing once a classroom passed a handful of
    //      students — quietly, and only in the classrooms big enough to hit it.
    match /artifacts/{appId}/sessions/{sessionId} {
      allow read: if request.auth != null
        && sessionOwnerIsMyStudent(appId, resource.data.get('uid', NONE()), request.auth.uid);
    }

    // 11. NEW — Telemetry events (append-only stream: module_open, step, choice,
    //     module_complete, ...). Nobody but the admin allowlist can read them back,
    //     and nothing can edit one after the fact.
    match /artifacts/{appId}/events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'role', 'ageTier', 'isGuest', 'module', 'gameName',
             'sessionId', 'event', 'step', 'meta', 'device', 'entry', 'ts', 'clientTs'
           ]);
      allow read, delete: if isAllowlistedAdmin();
    }

    // NEW — Read the Signal telemetry (append-only, one doc per completed game
    // session; see PROMPT-claude-code.md Ticket 3). Anonymous auth counts as
    // authenticated, so a student who never touched the login gate can still
    // have a session recorded. TTL purge on the `ttl` field is configured in
    // Firebase console, not here.
    match /game_sessions/{sessionDocId} {
      allow create: if request.auth != null
        && (
          (request.resource.data.game == 'read-the-signal'
            && request.resource.data.keys().hasOnly([
                 'game', 'sessionId', 'recruitCode', 'studentId', 'uid', 'playedAt', 'ttl',
                 'outcome', 'scenariosPlayed', 'correct', 'wrong', 'livesLost',
                 'categories', 'scenarios', 'clickedDeeperLink'
               ]))
          || (request.resource.data.game == 'before-you-send'
            && request.resource.data.keys().hasOnly([
                 'game', 'sessionId', 'recruitCode', 'studentId', 'uid', 'playedAt', 'ttl',
                 'scenariosPlayed', 'choices', 'correct', 'categories', 'scenarios',
                 'clickedDeeperLink'
               ]))
          || (request.resource.data.game == 'the-rumor-mill'
            && request.resource.data.keys().hasOnly([
                 'game', 'sessionId', 'recruitCode', 'studentId', 'uid', 'playedAt', 'ttl',
                 'scenariosPlayed', 'correct', 'choices', 'misinfoForwarded',
                 'truthStopped', 'verifyUsed', 'categories', 'scenarios', 'clickedDeeperLink'
               ]))
          || (request.resource.data.game == 'money-moves'
            && request.resource.data.keys().hasOnly([
                 'game', 'sessionId', 'recruitCode', 'studentId', 'uid', 'playedAt', 'ttl',
                 'scenariosPlayed', 'correct', 'categories', 'clickedDeeperLink'
               ]))
        );
      allow read, update, delete: if isAllowlistedAdmin();

      // NEW — lets a student mark their own session as "clicked through to the
      // recommended lesson" after finishing a game, without opening up any other
      // field on their own past sessions to a client-side write.
      allow update: if request.auth != null
        && resource.data.get('uid', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickedDeeperLink']);
    }

    // 11b. NEW — Mission Control: game telemetry (Read the Signal, Before You Send, The
    //      Rumor Mill, Money Moves) for a student in a classroom this uid teaches. Same
    //      one-uid-at-a-time query shape as 10b and the same rules-cost reason: a query
    //      pinned to a single uid resolves the same cached path for every doc it returns,
    //      where a classroom-wide query would re-look-up a student per document and start
    //      failing once a classroom passed a handful of students.
    match /game_sessions/{sessionDocId} {
      allow read: if request.auth != null
        && sessionOwnerIsMyStudent('allgood-academy', resource.data.get('uid', NONE()), request.auth.uid);
    }

    // 12. NEW — Collection-group reads for Insider. Rule #2 already lets the admin
    //     allowlist read any one user's subcollections, but a collectionGroup() query
    //     (every user's launches / game_scores / ... in ONE read, instead of one round
    //     trip per user) is only permitted by a rule written against the collection
    //     id with a {path=**} prefix. Admin-only, read-only — no new write paths.
    match /{path=**}/launches/{docId} {
      allow read: if isAllowlistedAdmin();
    }
    match /{path=**}/game_scores/{docId} {
      allow read: if isAllowlistedAdmin();
    }
    match /{path=**}/scenario_attempts/{docId} {
      allow read: if isAllowlistedAdmin();
    }
    match /{path=**}/module_progress/{docId} {
      allow read: if isAllowlistedAdmin();
    }

    // 3. Safety Catch: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
