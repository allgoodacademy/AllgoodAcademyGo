rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Checks if the user requesting data has "isInsider: true" on their own profile
    function isInsider(appId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.isInsider == true;
    }

    // 1. Allow Insiders to list the entire "users" collection (Critical for the Roster Table)
    match /artifacts/{appId}/users {
      allow list: if request.auth != null && isInsider(appId);
    }

    // 2. Individual User Documents & Subcollections (Launches, Scores, etc.)
    match /artifacts/{appId}/users/{userId}/{document=**} {
      // Rule A: Owners can read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Rule B: Insiders can READ any user's data (but not write/edit it)
      allow read: if request.auth != null && isInsider(appId);
    }

    // 4. NEW — Teachers can list + read (not write) the top-level profiles of students who
    //    joined THEIR classroom. Students outside a teacher's own classroom stay fully private.
    //    This does NOT expose a student's subcollections (launches/scores) — only the fields
    //    on their main user doc (name, email, classroomCode, role) that the roster view needs.
    match /artifacts/{appId}/users/{userId} {
      allow list, get: if request.auth != null
        && resource.data.role == 'student'
        && resource.data.classroomCode ==
             get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.classroomCode
        && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // 5. NEW — Classrooms: holds each teacher's join code.
    //    - Anyone signed in can GET a specific code (needed so a student can validate a code exists)
    //    - Only a teacher can CREATE a classroom, and only naming themselves as its teacher
    //    - Only that classroom's teacher can update/delete it later
    //    - LIST is denied — codes are shared out-of-band, no one should be able to browse all classrooms
    match /artifacts/{appId}/classrooms/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow list: if false;
    }

    // 6. NEW — Teachers can READ (not write) a classroom student's subcollections too
    //    (game_scores, launches) — needed so the roster can show real completion/scores,
    //    not just names. Still fully scoped to the teacher's own classroom, still read-only.
    match /artifacts/{appId}/users/{userId}/{subcollection}/{document=**} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)).data.role == 'student'
        && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)).data.classroomCode ==
             get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.classroomCode
        && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // 3. Safety Catch: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
